<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Deliberately plain net8.0 with no WinUI reference, for the same reason MCPRouter.Shell.Model
    is: every claim this project makes - the check semantics, the version-bound result rule, the
    copy, the store - must be measurable by a test that needs no display. The reference machine
    cannot host a XAML window from the session that runs the gates (spec-WIN3 §7 gap 1), so a
    claim checkable only against a running window is a claim nothing here can check.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MCPRouter.Checks.Model</RootNamespace>
  </PropertyGroup>
</Project>
