# Build output — regenerated by `npm run build`
dist/
*.tsbuildinfo

# Dependencies
node_modules/

# The router's own runtime state lives in ~/.claude/mcp-router/, never here,
# but keep these ignored in case someone runs with a local --config.
servers.json
manifest.json
*.log

# Generated launchd plists — install.sh writes these with machine-specific
# absolute paths (node binary, repo location), so they are never committed.
*.plist

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# macOS Finder droppings, at any depth
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# Fidelity-loop trajectory data: the per-round score.json and candidate.svg are
# the evidence and are committed; the residual/edge bitmaps are 21 MB of
# regenerable diagnostic imagery and stay local.
design/icon/runs/**/*.png
