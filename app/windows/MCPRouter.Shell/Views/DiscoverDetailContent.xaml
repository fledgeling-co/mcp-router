<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MCPRouter.Shell.Views.DiscoverDetailContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The content of the Discover detail dialog: everything the entry can honestly say about
      itself, and the requirement fields the Add needs. The Add button itself is the dialog's
      primary button - the one accent-filled action this board offers, in the leftmost position
      Windows guidance gives the "do it" action (DESIGN.md section 11 rule 4), with Close to its
      right.

      The capability statement is a READING of the entry's install block, labelled as such - no
      registry format carries a capability manifest, and a statement that read as declared would
      be a claim the entry never made.
    -->
    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
        <StackPanel Spacing="12">

            <!-- Who this is, and where each index says it came from. -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="NameText"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ProvenanceText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="FigureText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="DateText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="ArchivedText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <TextBlock
                x:Name="DescriptionText"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <!-- The capability statement: what will run, read off the install block. -->
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="StatementHeadline"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatementBody"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <!-- Argv in the instrument face, one token per TextBlock: a joined line reads as
                     a shell command, and an entry whose args contain spaces or quotes would
                     render as a different command from the one that will run. -->
                <ItemsControl x:Name="ArgvList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border
                                Margin="0,2"
                                Padding="6,2"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock
                                    Text="{x:Bind}"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    TextWrapping="NoWrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="DerivationNote"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- What the entry asks for before it can start. -->
            <StackPanel x:Name="RequirementsPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock
                    x:Name="RequirementsSummary"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="RequirementFields" Spacing="8" />
                <TextBlock
                    x:Name="SecretDestinationNote"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Why the Add is unavailable, next to the thing that is unavailable. -->
            <TextBlock
                x:Name="BlockedReasonText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- An install refusal, next to the button that was refused. -->
            <TextBlock
                x:Name="ErrorText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
