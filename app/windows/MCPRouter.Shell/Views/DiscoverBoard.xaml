<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MCPRouter.Shell.Views.DiscoverBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MCPRouter.Shell.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!--
      The Windows Discover board (spec-WIN7): two bands over the router's /registry/search, never
      one ranked list; no install affordance on a row (a row opens the detail dialog; the only Add
      lives there); a degraded registry draws as itself, distinctly from "nothing found".

      The XAML carries geometry and brush keys only. Every decision the board makes - which state
      it is in, what a row's date means, whether a figure may draw - lives in
      MCPRouter.Shell.Model.Registry and is gated headless. Every static string is assigned from
      DiscoverCopy in code-behind, so the gated catalog is the single source and nothing
      user-facing is literal here.
    -->
    <UserControl.Resources>
        <!-- One row of either band. Deliberately carrying no button, no command and no install
             affordance: the row's only action is opening the detail dialog. The figure carries
             its unit and its index or does not draw - never a zero, never a dash.

             NAMES ON THE AUTOMATION PLANE (DEF-084). The row's accessible name is NOT set here.
             What a screen reader and a UIA client read is the ListViewItem CONTAINER's name, and
             the container is generated by the ListView rather than by this template - a name on
             the template's root Grid names a child of the container and leaves the container
             itself announcing ToString() on the item, which is what published
             "MCPRouter.Shell.Views.DiscoverRow" for every row in the store. So the container is
             named in code, from DiscoverRow.AccessibleName, as each one is realised
             (OnRowContainerChanging), and none of the TextBlocks below carries a Name: each one
             already publishes its own Text, and a static Name would override it (DEF-075's rule,
             same reason). -->
        <DataTemplate x:Key="DiscoverRowTemplate" x:DataType="views:DiscoverRow">
            <Grid ColumnSpacing="12" Padding="0,6,0,6" MinHeight="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="30"
                    Height="30"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <TextBlock
                        Text="{x:Bind Monogram, Mode=OneTime}"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind DisplayName, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind Secondary, Mode=OneTime}"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasSecondary, Mode=OneTime}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind FigureText, Mode=OneTime}"
                        FontFamily="Consolas"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasFigure, Mode=OneTime}" />
                    <TextBlock
                        Text="{x:Bind InstalledText, Mode=OneTime}"
                        FontSize="12"
                        Visibility="{x:Bind HasInstalled, Mode=OneTime}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind DateText, Mode=OneTime}"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasDate, Mode=OneTime}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ProvenanceText, Mode=OneTime}"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasProvenance, Mode=OneTime}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <FontIcon
                    Grid.Column="4"
                    Glyph="&#xE76B;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- The loading skeleton: rows at the real row geometry, so nothing moves when data
             lands. A spinner over a blank pane is the failure mode DESIGN.md section 5 names. -->
        <DataTemplate x:Key="SkeletonRowTemplate">
            <Grid ColumnSpacing="12" Padding="0,6,0,6" MinHeight="44" Opacity="0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="30"
                    Height="30"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Border
                    Grid.Column="1"
                    Height="12"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Border
                    Grid.Column="2"
                    Height="12"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Padding="24,16,24,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================ the header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                x:Name="TitleText"
                Text="Discover"
                Style="{StaticResource TitleTextBlockStyle}"
                AutomationProperties.Name="Discover" />
            <!-- Empty while loading: a count that is not yet known is not a count, and
                 "Loading..." where a number belongs is a worse answer than nothing. -->
            <TextBlock
                x:Name="SubtitleText"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- ======================================================== the controls -->
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="360" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <muxc:AutoSuggestBox
                            x:Name="SearchBox"
                            Grid.Column="0"
                            QueryIcon="Find"
                            VerticalAlignment="Center" />
                        <!-- Deliberately "Search the server registries", not "Filter" (the design
                             system unit copy says so because the behaviour differs): this is a
                             query to two third-party indexes. -->

                        <muxc:ComboBox
                            x:Name="PublisherCombo"
                            Grid.Column="1"
                            MinWidth="150"
                            VerticalAlignment="Center"
                            SelectionChanged="OnPublisherChanged" />

                        <muxc:ComboBox
                            x:Name="WindowFilter"
                            Grid.Column="2"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            SelectionChanged="OnWindowChanged" />
                    </Grid>
                    <!-- Section 6 helper text: the window asymmetry is stated on the control
                         itself rather than left to be discovered. -->
                    <TextBlock
                        x:Name="WindowNote"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- ================================================== the state regions -->
                <StackPanel x:Name="LoadingPane" Spacing="12" Visibility="Collapsed">
                    <TextBlock
                        x:Name="LoadingHeadlineText"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <muxc:ItemsControl x:Name="SkeletonRows" ItemTemplate="{StaticResource SkeletonRowTemplate}" />
                    <TextBlock
                        x:Name="SlowSearchNote"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Disconnected: the router own state, never a generic error. The router is
                     local on Windows, so the copy says so; starting it is WIN23 surface and is
                     not faked here. -->
                <StackPanel x:Name="OfflinePane" Spacing="8" Visibility="Collapsed">
                    <TextBlock
                        x:Name="OfflineHeadlineText"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="OfflineBodyText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button x:Name="OfflineRetryButton" Click="OnRetryClicked" />
                </StackPanel>

                <!-- Failed outright, with a reason rendered from a closed enum. -->
                <StackPanel x:Name="FailedPane" Spacing="8" Visibility="Collapsed">
                    <TextBlock
                        x:Name="FailedHeadlineText"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="FailedReasonText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button x:Name="FailedRetryButton" Click="OnRetryClicked" />
                </StackPanel>

                <!-- Whole-board empties. -->
                <StackPanel x:Name="EmptyPane" Spacing="8" Visibility="Collapsed">
                    <TextBlock
                        x:Name="EmptyHeadline"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="EmptyBodyText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="EmptyAction"
                        Click="OnEmptyActionClicked"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- The partial state: what arrived, what did not, and why - never collapsed
                     into "nothing found". -->
                <StackPanel x:Name="PartialPane" Spacing="8" Visibility="Collapsed">
                    <TextBlock
                        x:Name="PartialHeadline"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="PartialBodyText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button x:Name="PartialRetryButton" Click="OnRetryClicked" />
                </StackPanel>

                <!-- Stale: last good reading kept on screen, with the live failure named. -->
                <Border
                    x:Name="StaleBanner"
                    Padding="12,8"
                    CornerRadius="4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="StaleHeadlineText"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            x:Name="StaleReasonText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ======================================================== the two bands -->
                <StackPanel x:Name="BandsPane" Spacing="4" Visibility="Collapsed">
                    <!-- Band 1: Recently changed - the editorial claim. -->
                    <StackPanel Spacing="2" Margin="0,4,0,0">
                        <TextBlock
                            x:Name="RecentBandTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="RecentBandNote"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        x:Name="RecentEmptyText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"
                        Visibility="Collapsed" />
                    <muxc:ListView
                        x:Name="RecentList"
                        AutomationProperties.Name="Recently changed capabilities"
                        AutomationProperties.AutomationId="discover.band.recent"
                        IsItemClickEnabled="True"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource DiscoverRowTemplate}"
                        ContainerContentChanging="OnRowContainerChanging"
                        ItemClick="OnRowClicked" />

                    <!-- Band 2: Most used - the measured claim. The window never reaches it. -->
                    <StackPanel Spacing="2" Margin="0,16,0,0">
                        <TextBlock
                            x:Name="UsedBandTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="UsedBandNote"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        x:Name="UsedEmptyText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"
                        Visibility="Collapsed" />
                    <muxc:ListView
                        x:Name="UsedList"
                        AutomationProperties.Name="Most used capabilities"
                        AutomationProperties.AutomationId="discover.band.used"
                        IsItemClickEnabled="True"
                        SelectionMode="Single"
                        ItemTemplate="{StaticResource DiscoverRowTemplate}"
                        ContainerContentChanging="OnRowContainerChanging"
                        ItemClick="OnRowClicked" />
                </StackPanel>

                <!-- ==================================================== the notes footer -->
                <StackPanel x:Name="NotesPane" Spacing="4" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock
                        x:Name="RankingNoteText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <!-- The trending refusal, stated always: the brief rule resolves to "not
                         drawn" for every row this data can produce, and the surface says why. -->
                    <TextBlock
                        x:Name="TrendingNoteText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
