{
  "name": "mcp-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "description": "One shared HTTP MCP endpoint that lazily spawns stdio upstreams on first use and reaps them when idle.",
  "bin": { "mcp-router": "dist/index.js" },
  "scripts": {
    "prebuild": "bash scripts/worktree-preflight.sh node",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.test.json && node --test 'build-test/test/*.test.js'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@peculiar/x509": "2.2.0",
    "bonjour-service": "1.4.4",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
