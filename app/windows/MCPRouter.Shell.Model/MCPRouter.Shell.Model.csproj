<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Deliberately plain net8.0 with no WinUI reference.

    Every structural claim the shell makes - the destination set, the command surface, the
    access keys, the accelerators, the casing - lives here so it can be measured by a test that
    needs no display. The reference machine cannot host a XAML window from the session that runs
    the gates (spec-WIN3 §7 gap 1), so a claim that can only be checked against a running window
    is a claim nothing here can check.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MCPRouter.Shell.Model</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The skill checks return the same CheckResult the server checks do, so the vocabulary is shared. -->
    <ProjectReference Include="..\MCPRouter.Checks.Model\MCPRouter.Checks.Model.csproj" />
  </ItemGroup>
</Project>
