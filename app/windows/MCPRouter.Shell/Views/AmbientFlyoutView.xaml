<UserControl
    x:Class="MCPRouter.Shell.Views.AmbientFlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="320">

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Padding="16">
        <StackPanel Spacing="12">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="MCP Router" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Open App" Style="{ThemeResource SubtleButtonStyle}" Click="OnOpenAppClicked" />
            </Grid>

            <!-- State Summary -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StatusTitleText" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetailText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <StackPanel Spacing="8">
                <Button x:Name="ViewInboxButton" Content="Review Inbox (0)" HorizontalAlignment="Stretch" Click="OnViewInboxClicked" />
                <Button x:Name="ViewServersButton" Content="View Servers" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Stretch" Click="OnViewServersClicked" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
