<UserControl
    x:Class="MCPRouter.Shell.Views.InsightsBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,16,24,32" Spacing="20" MaxWidth="1080" HorizontalAlignment="Left">
                <!-- Board Head -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TitleText" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock x:Name="DescriptionText"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="720" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <TextBlock x:Name="WindowText" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Notices: a stale reading, an unreachable router, the qualifications on the figures -->
                <StackPanel x:Name="NoticeContainer" Spacing="4" />

                <!-- Headline figures, drawn from the snapshot -->
                <Grid x:Name="FigureContainer" Margin="0,8,0,0" />

                <!-- Section: Harness Breakdown -->
                <StackPanel x:Name="HarnessSection" Spacing="8">
                    <TextBlock Text="Where calls came from" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <StackPanel x:Name="HarnessBreakdownContainer" />
                    </Border>
                </StackPanel>

                <!-- Section: Session analyst. Its one action is enabled exactly when the router serves the route. -->
                <StackPanel x:Name="AnalystSection" Spacing="8">
                    <TextBlock Text="Session analyst" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="16">
                        <StackPanel x:Name="AnalystContainer" Spacing="8" />
                    </Border>
                    <Button x:Name="AnalyseNowButton" Content="Analyse now" Click="AnalyseNowButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
