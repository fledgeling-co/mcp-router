<UserControl
    x:Class="MCPRouter.Shell.Views.CapabilityDocumentPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,16,24,32" Spacing="16" MaxWidth="880" HorizontalAlignment="Left">
                <!-- Header -->
                <TextBlock x:Name="PackageTitle" Text="Capability Document" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />

                <!-- Update Gate Warning Box (Capability diff before content diff) -->
                <Border x:Name="UpdateGateCard"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Update held for review" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="A new version never applies live: it lands as a shadow copy, evals re-run against it, and it promotes itself only if the capability diff is empty. This one gained new capabilities, so it stopped for your review."
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />

                        <!-- Delta list -->
                        <TextBlock Text="New capabilities requested:" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <StackPanel x:Name="DeltasContainer" Spacing="4" />

                        <!-- Gate actions -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Content="Approve and promote" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <Button Content="Keep current version" Style="{ThemeResource SubtleButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="TabCaps" Content="Capabilities" FontWeight="SemiBold" />
                    <Button x:Name="TabChangelog" Content="Changelog" Style="{ThemeResource SubtleButtonStyle}" />
                    <Button x:Name="TabFlags" Content="Flags worth knowing" Style="{ThemeResource SubtleButtonStyle}" />
                </StackPanel>

                <!-- Changelog view -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Padding="16">
                    <TextBlock x:Name="ChangelogBlock" Text="Loading changelog..." Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
