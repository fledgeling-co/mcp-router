<Project>
  <!--
    Shared settings for every Windows client project.

    Two of these are measurements rather than preferences, and both are recorded in
    planning/specs/spec-WIN3.md §7:

    * WindowsAppSDK is pinned to 1.7 and built self-contained. Microsoft.WindowsAppRuntime.1.6
      is not installed on the reference machine (1.5, 1.7, 1.8 and 2.x are), and an unpackaged
      1.6 build launches into "This application could not be started" - a dialog with a live
      process behind it, which reads as a running app to anything watching the exit code.
      Self-contained removes the dependency on a machine-installed runtime entirely.

    * These projects are built with Visual Studio's MSBuild.exe, never `dotnet build`, which
      resolves MSBuildExtensionsPath to the .NET SDK and fails MSB4062 on the PRI tasks however
      complete the Visual Studio install is. WIN1 measured that; scripts/windows/build-shell.ps1
      is the invocation.
  -->
  <PropertyGroup>
    <WindowsAppSdkVersion>1.7.250606001</WindowsAppSdkVersion>
    <WindowsSdkBuildToolsVersion>10.0.26100.1742</WindowsSdkBuildToolsVersion>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
