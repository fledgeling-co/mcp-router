# Build output — regenerated by `npm run build`
dist/
*.tsbuildinfo

# Dependencies
node_modules/
# The bare name too: a worktree symlinks node_modules to the main checkout, and a symlink
# is a file to git, so the trailing-slash pattern above does not match it. One was committed
# that way — an absolute path to one machine, in a public repo.
node_modules

# The router's own runtime state lives in ~/.claude/mcp-router/, never here,
# but keep these ignored in case someone runs with a local --config.
# Anchored to the repo root: unanchored, these match at every depth, and the bare
# name silently swallowed app/Sources/MCPRouterKit/Control/Fixtures/servers.json —
# a source file, gone from the branch while still present in its author's worktree,
# so its own gate passed and only the merged tree failed.
/servers.json
/manifest.json
*.log

# Generated launchd plists — install.sh writes these with machine-specific
# absolute paths (node binary, repo location), so they are never committed.
*.plist

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# macOS Finder droppings, at any depth
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# Fidelity-loop trajectory data: the per-round score.json and candidate.svg are
# the evidence and are committed; the residual/edge bitmaps are 21 MB of
# regenerable diagnostic imagery and stay local.
design/icon/runs/**/*.png

# Xcode / Swift
.build/
DerivedData/
*.xcuserdatad
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
.swiftpm/

# XcodeGen generates the project and the Info.plists from app/project.yml. Tracking generated
# artifacts is what produces project.pbxproj merge conflicts between parallel branches, and this
# fleet runs several at once — run `make generate` (or `xcodegen generate`) after checkout.
*.xcodeproj/
app/**/Info.plist
app/.derived/
